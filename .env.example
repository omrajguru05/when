# Public site URL (no trailing slash). Used for OAuth redirects and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Resend (https://resend.com — 100 emails/day free)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL="WHEN <hello@yourdomain.com>"

# Google Calendar OAuth (https://console.cloud.google.com)
# Authorized redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/google/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
